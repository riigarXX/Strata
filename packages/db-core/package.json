{
  "name": "@strata/db-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./postgres": {
      "types": "./src/postgres/index.ts",
      "default": "./src/postgres/index.ts"
    },
    "./sqlite": {
      "types": "./src/sqlite/index.ts",
      "default": "./src/sqlite/index.ts"
    },
    "./sqlite/worker": {
      "types": "./src/sqlite/worker.ts",
      "default": "./src/sqlite/worker.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "test:integration": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@strata/contracts": "workspace:*",
    "better-sqlite3": "12.11.1",
    "pg": "8.23.0",
    "pg-cursor": "2.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/pg-cursor": "2.7.2",
    "electron": "44.4.3",
    "esbuild": "0.25.12",
    "vitest": "5.0.1"
  }
}
