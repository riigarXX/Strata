{
  "name": "@strata/desktop",
  "version": "0.0.0",
  "private": true,
  "productName": "Strata",
  "description": "Strata desktop app (Electron + Vue 3)",
  "main": "./out/main/index.js",
  "scripts": {
    "tokens": "pnpm --filter @strata/design-tokens build",
    "predev": "pnpm tokens",
    "dev": "electron-vite dev",
    "prebuild": "pnpm tokens",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "pretypecheck": "pnpm tokens",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icon": "node build/make-icon.mjs",
    "pack": "electron-builder --mac --arm64 --dir",
    "dist": "electron-builder --mac --arm64",
    "postinstall": "install-electron && electron-rebuild -w better-sqlite3"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "pg": "8.23.0",
    "pg-cursor": "2.22.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@electron/fuses": "2.1.3",
    "@electron/rebuild": "4.2.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@lezer/highlight": "1.2.3",
    "@playwright/test": "1.63.0",
    "@strata/commands": "workspace:*",
    "@strata/contracts": "workspace:*",
    "@strata/db-core": "workspace:*",
    "@strata/design-tokens": "workspace:*",
    "@types/node": "24.13.6",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "happy-dom": "20.14.5",
    "pinia": "4.0.3",
    "sql-formatter": "15.8.2",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "5.0.1",
    "vue": "3.5.43",
    "vue-tsc": "3.3.11"
  }
}
